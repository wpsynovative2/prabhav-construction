# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the two values.
# Both are inlined at build time, so restart `next dev` / re-run `next build`
# after changing them.
# See google-apps-script/README.md for how to obtain each one.
# ---------------------------------------------------------------------------

# Google Apps Script Web App URL (ends in /exec) that receives form submissions
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Google reCAPTCHA v3 SITE key (the secret key goes in Apps Script, not here)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
